# /propuesta-gustavo — variables OBLIGATORIAS para que la puerta funcione.
# Cargalas también en el panel de Amplify (Hosting → Environment variables)
# antes de desplegar; amplify.yml las copia a .env.production en el build.

# Clave que se ingresa en la pantalla de acceso (acordada con la destinataria).
PROPUESTA_PASSWORD=cambiame

# Secreto para firmar la cookie de sesión (HMAC). Generá uno largo al azar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROPUESTA_COOKIE_SECRET=cambiame-por-64-hex-al-azar

# Bucket S3 PRIVADO con los archivos grandes (video, audio, ZIP) y
# credenciales de un usuario IAM de SOLO LECTURA sobre ese bucket
# (el script de infra crea el usuario personal-site-media-reader).
# Si faltan, la página degrada: sin reproductores y sin "Descargar todo".
PROPUESTA_S3_BUCKET=gabriel-personal-site-media-452157035969
PROPUESTA_S3_REGION=us-east-1
PROPUESTA_S3_KEY_ID=cambiame
PROPUESTA_S3_SECRET=cambiame
