# /propuesta-gustavo — variables OBLIGATORIAS para que la puerta funcione.
# Cargalas también en el panel de Amplify (App settings → Environment variables)
# antes de desplegar; amplify.yml las copia a .env.production en el build.

# Clave que se ingresa en la pantalla de acceso (acordada con la destinataria).
PROPUESTA_PASSWORD=cambiame

# Secreto para firmar la cookie de sesión (HMAC). Generá uno largo al azar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROPUESTA_COOKIE_SECRET=cambiame-por-64-hex-al-azar
